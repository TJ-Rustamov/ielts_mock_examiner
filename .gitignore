# Ignore everything in the root
/*

# Whitelist essential root files and directories
!/.gitignore
!/LICENSE
!/README.md
!/docker-compose.yml
!/backend/
!/frontend/

# Globally ignore OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python / Backend ignores
backend/__pycache__/
backend/**/*.py[cod]
backend/**/*.pyo
backend/**/*.pyd
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/
backend/.venv/
backend/venv/
backend/env/
backend/db.sqlite3
backend/*.sqlite3
backend/media/
backend/staticfiles/
backend/.env

# Node / Frontend ignores
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.parcel-cache/
frontend/.next/
frontend/.nuxt/
frontend/coverage/
frontend/.npm-cache/

# Ignore environment files
.env
.env.*
!.env.example

# Ignore logs and temp files
*.log
*.tmp
*.temp