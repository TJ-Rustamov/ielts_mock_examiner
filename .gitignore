# Ignore everything in the root
/*

# Whitelist essential root files and directories
!/.gitignore
!/LICENSE
!/README.md
!/docker-compose.yml
!/backend/
!/frontend/

# Globally ignore OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Globally ignore Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Backend specific ignores
backend/db.sqlite3
backend/*.sqlite3
backend/media/
backend/staticfiles/
backend/.env

# Node / Frontend ignores
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.parcel-cache/
frontend/.next/
frontend/.nuxt/
frontend/coverage/
frontend/.npm-cache/

# Ignore environment files
.env
.env.*
!.env.example

# Ignore logs and temp files
*.log
*.tmp
*.temp