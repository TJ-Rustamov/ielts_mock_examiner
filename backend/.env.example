DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
SQLITE_PATH=D:/university/backend/db.sqlite3

GEMINI_API_KEY=
GEMINI_SPEAKING_MODEL=gemini-3.1-flash-lite-preview
GEMINI_WRITING_MODEL=gemini-3.1-flash-lite-preview
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.8
GEMINI_JSON_RETRY_COUNT=2

KOKORO_MODEL_PATH=/models/Kokoro-82M/kokoro-v1_0.pth
KOKORO_VOICE=af_heart
KOKORO_LANG_CODE=a
KOKORO_DEVICE=cpu

WHISPER_MODEL_SIZE=/models/faster-whisper-base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

MAX_AUDIO_SECONDS=120
VAD_MODE=2
VAD_SILENCE_FRAMES=12
PCM_FORCE_TRANSCRIBE_SECONDS=6
TTS_PLAYBACK_ACK_TIMEOUT_MS=12000
PREP_SECONDS_PART2=60
SPEAKING_SECONDS_PART1=300
SPEAKING_SECONDS_PART2=120
SPEAKING_SECONDS_PART3=300
SPEAKING_SECONDS_ALL=840

# Docker backend build option: set to false to skip heavy voice deps (torch/kokoro/whisper).
INSTALL_VOICE=true
